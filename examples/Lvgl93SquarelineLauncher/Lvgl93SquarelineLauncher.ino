/*******************************************************************************
 * Waveshare ESP32-S3-Touch-LCD-7 / -7B LVGL 9.3 Squareline Launcher
 *
 * Demonstrates the display and touch libraries for the
 * Waveshare ESP32-S3-Touch-LCD-7 / -7B development board.
 *
 * Requires the following libraries:
 *   - chipguy_Waveshare-ESP32-S3-Touch-LCD-7-7B_display  (1024x600 RGB LCD + GT911 touch, this library)
 *   - chipguy_Waveshare-ESP32-S3-Touch-LCD-7-7B_board   (shared I2C bus + expander; a dependency)
 *   - lvgl 9
 *
 * Arduino IDE Board Settings:
 *   - Board: ESP32S3 Dev Module
 *   - PSRAM: OPI PSRAM
 *   - Upload Speed: 230400  (faster rates corrupted on the -7B's CH343 link;
 *     the -7 takes 460800)
 *   - Flash Size: 8MB (64Mb) and Partition Scheme: 8M with spiffs (3MB APP/1.5MB
 *     SPIFFS) work on both boards.  The -7B has 16 MB: 16MB (128Mb) and
 *     16M Flash (3MB APP/9.9MB FATFS) use all of it.
 *   - Serial output: the USB-C port marked UART (on the -7B, with the
 *     UART1/UART2 switch on UART1).  Serial0 always prints there.
 *
 * Copyright (c) 2025 chipguyhere
 * MIT License
 ******************************************************************************/

// This is built for LVGL 9.3, which Squareline can generate UI's for.
// It's important for the version numbers to match, even if it's not newest.
#include "lv_conf.h"
#include "lvgl.h"
#include "lv_setup.hpp"

// Fonts
// The Montserrat font is built into LVGL in multiple sizes, each size takes up memory.
// We enable the 14 point font as a default font.
#define LV_FONT_MONTSERRAT_14 1
// need other sizes?  Edit lv_conf.h where they are turned off (0) and turn them on (1)

// The folder of UI files generated by Squareline should be a src subdirectory in the sketch folder.
// Simply DELETE all of the example files, and "Export UI files" from Squareline.
// Using the Arduino TFT_eSPI profile from Squareline works
// Required settings: your board's resolution -- 1024x600 for the -7B, 800x480
// for the -7 (a SquareLine project is laid out for one size; the bundled
// placeholder is centre-aligned, so it fits both) -- 16-bit color depth, no
// rotation or offset.
#include "src/ui.h"


void setup() {
    // Serial0 is UART0, which reaches the USB-C port marked UART (on the
    // -7B, when the UART1/UART2 switch is on UART1).
    Serial0.begin(115200);

    // Initialize display, touch, and LVGL.
    // Rotation: lv_setup.begin(180) for an upside-down panel, or begin(90) /
    // begin(270) for portrait (600x1024 or 480x800).  See the README.
    // Half resolution: LVGL draws 512x300 (-7B) or 400x240 (-7) and the display scales it up 2x,
    // smoothly.  Much faster motion and scrolling; small text looks softer.
    // Good for walk-up UIs with big buttons.  Only for a SquareLine project
    // made at half the panel's size (512x300 or 400x240) -- a full-size one
    // won't fit.  Uncomment to use it:
    // lv_setup.halfResolution = true;
    lv_setup.begin();
    Serial0.printf("LVGL initialized with %dx%d touchscreen\n", display.width(), display.height());

    // Start the Squareline application
    ui_init();
}


void loop() {
    // Give control to LVGL objects created by Squareline application
    lv_timer_handler(); /* let the GUI do its work */
    delay(5);
}
